# ─────────────────────────────────────────────────────────────
#  3AMMM Server — Environment Variables
#  Copy this file to .env and fill in your values
# ─────────────────────────────────────────────────────────────

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/3ammm?retryWrites=true&w=majority

# JWT secret — use any long random string (keep it secret!)
JWT_SECRET=36684f053c1c8d1215cc9738d78a4a6dedbbfc844dbed05a5acf3f0563d8464dd1c6d6815384192c266ecd7b9f4a70e6

# JWT expiry
JWT_EXPIRES_IN=30d

# Server port
PORT=5000

# App environment
NODE_ENV=development

# CORS (production only — comma-separated origins or *)
CORS_ORIGIN=*

# Google OAuth (for POST /api/auth/google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=com.ammm.worship://
